{% extends "../../partials/layout.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/breadcrumbs/macro.njk" import govukBreadcrumbs %}

{% set title = "Change user roles in bulk" %}

{% block beforeContent %}
  {{ govukBreadcrumbs({
    items: [
      { text: "Home", href: homeUrl },
      { text: "Manage user accounts", href: '/' },
      { text: title }
    ]
  }) }}
{% endblock %}

{% block content %}

  {% set hasValidationErrors = errors and errors.length > 0 %}

  {% if errors %}
    {{ govukErrorSummary({
      titleText: "There is a problem",
      errorList: errors,
      attributes: { 'data-qa': 'error-summary' }
    }) }}
  {% endif %}

  {% if submitRequestError %}
    {{ govukErrorSummary({
      titleText: "There was a problem",
      errorList: submitRequestError,
      attributes: { 'data-qa': 'submit-error-summary' }
    }) }}
  {% endif %}

  <h1 class="govuk-heading-l">Please confirm change details</h1>

  {% set roleList %}
    <ul>
      {% for r in summary.roles %}
        <li>{{ r }}</li>
      {% endfor %}
    </ul>
  {% endset %}

  {% set jiraHref = "https://dsdmoj.atlassian.net/browse/" + (summary.jiraReference | urlencode) %}
  {% set jiraLink = '<a class="govuk-body govuk-link noDoubleClick" href="' + jiraHref + '">' + summary.jiraReference + '</a>' | safe %}

  <form action="{{ submitUrl }}" method="post">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}" />

    {{ govukSummaryList({
      rows: [
        {
          key: { text: "Requested by" },
          value: { text: summary.requestedBy }
        },
        {
          key: { text: "Jira reference" },
          value: { html: jiraLink | safe },
          actions: {
            items: [
              {
                href: changeJiraReferenceUrl,
                text: "Change",
                id: "change-jira-ref",
                visuallyHiddenText: "Jira reference"
              }
            ]
          }
        },
        {
          key: { text: "Roles" },
          value: { html: roleList | safe },
          actions: {
            items: [
              {
                href: changeRolesUrl,
                text: "Change",
                visuallyHiddenText: "Selected roles",
                id: "change-roles-ref"
              }
            ]
          }
        },
        {
          key: { text: "Uploaded file" },
          value: { text: summary.uploadFile },
          actions: {
            items: [
              {
                href: changeUploadFileUrl,
                text: "Change",
                visuallyHiddenText: "Uploaded file",
                id: "change-users-ref"
              }
            ]
          }
        },
        {
          key: { text: "Number of users" },
          value: { text: summary.totalNumberOfUsers }
        },
        {
          key: { text: "Total assignments" },
          value: { text: summary.totalAssignments }
        }
      ],
      attributes: {
        id: "bulk-user-roles-summary-list"
      }
    }) }}

    {{ govukButton({
      text: "Accept and submit request",
      id: "accept-confirm",
      preventDoubleClick: true,
      disabled: hasValidationErrors
    }) }}

  </form>

{% endblock %}
