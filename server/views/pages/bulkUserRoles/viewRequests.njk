{% extends "../../partials/layout.njk" %}
{% from "moj/components/search/macro.njk" import mojSearch %}
{% from "moj/components/badge/macro.njk" import mojBadge %}
{%- from "moj/components/pagination/macro.njk" import mojPagination -%}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/breadcrumbs/macro.njk" import govukBreadcrumbs %}

{% set title = "View bulk role changes" %}

{% block beforeContent %}
  {{ govukBreadcrumbs({
    items: [
      { text: "Home", href: homeUrl },
      { text: "Manage user accounts", href: '/' },
      { text: title }
    ]
  }) }}
{% endblock %}

{% block content %}

  {% if getRequestsError %}
    {{ govukErrorSummary({
      titleText: "There is a problem",
      errorList: [
        { text: getRequestsError }
      ],
      attributes: { 'data-qa': 'error-summary' }
    }) }}
  {% endif %}

  <h1 class="govuk-heading-l">{{ title }}</h1>

  {{ mojSearch({
    action: '#',
    method: 'get',
    input: {
      id: 'request-search-keyword',
      name: 'keyword'
    },
    label: {
      text: 'Find a request',
      classes: 'govuk-!-font-weight-bold'
    },
    hint: {
      text: 'You can search by Jira reference or Requested By'
    },
    button: {
      text: 'Search'
    }
  }) }}

  <br />

  {{ mojPagination(pagination) }}

  <table class="govuk-table" data-module="moj-sortable-table" id="bulk-user-roles-requests-table">
    <thead class="govuk-table__head">
      <tr class="govuk-table__row">
        <th scope="col" class="govuk-table__header" aria-sort="descending" id="sort-by-request-date">Date of request</th>
        <th scope="col" class="govuk-table__header">Jira reference</th>
        <th scope="col" class="govuk-table__header">Requested By</th>
        <th scope="col" class="govuk-table__header">Processing Status</th>
        <th scope="col" class="govuk-table__header">Status</th>
        <th scope="col" class="govuk-table__header">Request Details</th>
      </tr>
    </thead>
    <tbody class="govuk-table__body">

      {% for r in bulkUserRolesRequests %}

        {% if r.status == 'COMPLETE' %}
          {% set statusClass = "moj-badge--green" %}
        {% elseif r.status == 'PENDING' %}
          {% set statusClass = "moj-badge--grey" %}
        {% else %}
          {% set statusClass = "moj-badge--red" %}
        {% endif %}

        <tr class="govuk-table__row">
          <td class="govuk-table__cell" data-sort-value="{{ r.requestDateTime }}">{{ r.requestDateTime | formatDate('DD/MM/YYYY HH:mm') }}</td>
          <td class="govuk-table__cell"><a href="https://dsdmoj.atlassian.net/browse/{{ r.jiraReference }}" class="govuk-body govuk-link noDoubleClick">{{ r.jiraReference }}</a></td>
          <td class="govuk-table__cell">{{ r.requestedBy }}</td>
          <td class="govuk-table__cell">{{ r.status }}</td>
          <td class="govuk-table__cell">{{ mojBadge({ text: r.status, classes: statusClass }) }}</td>
          <td class="govuk-table__cell"><a href="{{ detailsUrl(r.id) }}" class="govuk-body govuk-link noDoubleClick">View details</a></td>
        </tr>
      {% endfor %}

    </tbody>
  </table>

  {{ mojPagination(pagination) }}

{% endblock %}
